# 情侣网站 assets/img/uploads/ 保护模板（由 tools/deploy.py 部署为远程 assets/img/uploads/.htaccess）
# ⚠️ 同源约束（第七轮 S12-03）：lib/store.php 的 love_protect_uploads_dir() 内置了一份
#    与本文件**指令集逐字相同**的文本，并在每次数据写入时按内容比对 —— 与它不一致
#    就**覆盖**线上这份（没有日志，tools/_verify_remote.py 只会报"线上与本地不一致"）。
#    改本文件的指令集必须同时改 lib/store.php 那份（或把运行时改成"只补缺不覆盖"），
#    否则下次任何数据写入都会把线上文件写回旧内容。本注释头同样会被那次覆盖带走。
# 作用：该目录只存放上传的照片；禁止目录列表、禁止脚本执行，
#       并且**禁止任何直链**——照片只能通过根目录的 photo.php 代理读取
#       （photo.php 会校验解锁 Cookie，未解锁一律 403）。
Options -Indexes
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>
