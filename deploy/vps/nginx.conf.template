# ============================================================
# 情侣网站 · 自有服务器(VPS) Nginx 完整站点配置
# ------------------------------------------------------------
# 与 deploy/nginx.conf 的分工：
#   deploy/nginx.conf          —— 通用示例，给人手动粘贴到宝塔/任意主机
#   本文件(deploy/vps/)        —— 自有 VPS 的**权威配置**，由 tools/vps_setup.py
#                                渲染占位符后整份装到 /etc/nginx/sites-available/love
# 这么做的原因：2026-09-15 体检发现服务器上那份是手写的、和项目模板漂移了，
# 漏掉了 add_header 不继承导致的安全头丢失。纳入版本控制后不会再漂。
#
# 占位符（由 tools/vps_setup.py 渲染，改名要同步改脚本）：
#   DOMAIN      站点域名（同时用于 certbot 证书目录名）
#   ROOT        站点根目录（dist 内容所在位置）
#   PHP_SOCK    PHP-FPM 的 unix socket 路径
#   —— 模板正文里的写法是上面三个名字两侧各加两条下划线。
#   注意：本注释段刻意不写那两个下划线的原始形态，否则渲染时会被一起替换掉，
#   这里会变成一句"说明里写着真实值"的废话。
#
# 装完必须 `sudo nginx -t` 再 reload；tools/vps_setup.py 会自动做，失败回滚。
# ============================================================

server {
    server_name __DOMAIN__;

    # 只服务本域名。2026-09-15 实测：443 上原本**没有任何 Host 校验**，把任意域名
    # 解析到本机 IP 都能拿到整站（200）；而同一个配置的 80 块早就用同一个写法挡掉了
    # 这类请求（返回干净的 404）。这里补齐，让两个块口径一致 —— 否则本站会被
    # "指向该 IP 的任何域名"镜像一份，且对方域名下会照常带我们的 HSTS/安全头。
    # 用 server 级 `if` 只做 return 是安全的（不涉及 rewrite 链），与 80 块同款。
    # 代价：直接访问裸 IP 会看到 404 而不是"证书告警 + 站点"，这正是想要的效果。
    if ($host != __DOMAIN__) { return 404; }

    root __ROOT__;
    # 必须带 index.php，否则 /admin/ 打不开
    index index.php index.html;

    # 请求体上限。照片是 base64 塞在 JSON 里发的（不是 multipart 文件上传），
    # 真正的业务上限是 lib/content.php 的 PHOTO_MAX_BASE64 = 3MB。
    # 这里 20m 是外层护栏，PHP 侧 post_max_size = 8M 是内层护栏，两层都远大于
    # 3MB，够用。注意 PHP 的 upload_max_filesize = 2M 在这里**不适用** ——
    # 那只管 multipart 文件上传，本项目不走那条路。
    client_max_body_size 20m;

    # 声明响应编码。Apache 那条路径默认就带 charset（AddDefaultCharset），nginx
    # 不带 —— 中文站点只靠 HTML 里的 <meta charset> 兜底，两条部署路径行为不一致。
    # charset 只**声明**、不改写内容（没有 charset_map/source_charset 就不会转码），
    # 且只作用于 charset_types 列的类型（text/html、text/css、application/javascript 等），
    # 接口的 application/json 与音乐的 application/octet-stream 都不在其列，零风险。
    charset utf-8;

    # 不对外暴露 nginx 版本号。默认会在响应头 `Server:` 与 404 页面正文里写出
    # "nginx/1.18.0 (Ubuntu)"（实测可见）—— 等于免费告诉扫描器该打哪个 CVE。
    # 关掉后仍会保留 `Server: nginx`，这是正常且必要的。
    server_tokens off;

    access_log /var/log/nginx/love.access.log;
    error_log  /var/log/nginx/love.error.log;

    # ---------- gzip ----------
    gzip on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_vary on;

    # ---------- 敏感目录：一律拒绝 ----------
    # ⚠️ Nginx 不读 .htaccess！data/ 与 lib/ 必须靠下面的 deny 规则保护，否则
    #    data/admin.json（含密码哈希）、data/content.json（私密留言/情书）和
    #    lib/*.php 会被直接下载，解锁密码形同虚设。
    #    tools/deploy_vps.py 故意不上传 deploy/*-htaccess 那几个 Apache 模板，
    #    保护完全由这一段承担；改这里前先确认 photo.php 与后台仍然可用。
    #
    #    点文件（.htaccess / .git / .env 之类）单独一条规则拒绝：nginx 既不读
    #    .htaccess、也**不会**自动拒绝它 —— 默认行为就是把它当普通文件下载出去。
    #    本项目构建产物里没有点文件（2026-09-15 实测确认），这条是防将来手滑：
    #    手工上传、换部署工具、编辑器产生临时文件都可能往站点根塞点文件。
    #    `.well-known/` 单独放行：certbot 的 HTTP-01 校验要用它（本机走的是 nginx
    #    插件、不是 webroot，留白名单是为了将来换续期方式时不踩坑）。
    location ~* /\.(?!well-known/) { deny all; }

    location ^~ /data/   { deny all; }
    location ^~ /lib/    { deny all; }
    location ^~ /deploy/ { deny all; }

    # 上传目录：照片只允许通过根目录 /photo.php 代理读取（服务端校验解锁 Cookie）
    location ^~ /assets/img/uploads/ { deny all; }
    # assets/img/ 下直接放进服务器的真实照片，同样只能走 photo.php
    location ~* ^/assets/img/[^/]+\.(jpe?g|png|webp|gif)$ { deny all; }

    # ---------- PHP ----------
    location ~ \.php$ {
        try_files $uri =404;

        # ⚠️ 这里**刻意不写** `error_page 404 =404;` / `error_page 403 =403;`。
        # 2026-09-15 在本机上实测发现：这种**不带 URI** 的 `=404` 写法不是"保持原
        # 状态码"，nginx 会把 `=404` 当成跳转目标 URI，于是缺失的 .php 会返回
        # `302 Location: =404` 而不是 404。同一份配置里 `.html` 那个 location 没写
        # 这行，返回的就是正确的 404 —— 对比非常清楚，就是这行造成的。
        # 正确做法是压根不使用 server 级的 `error_page 404 /index.html` 兜底首页
        # （本模板没有它），这样 PHP 与静态文件的 404/403 自然原样透传。
        # 如果你确实想要"找不到页面就回首页"，**不要**用全局 error_page ——
        # 它会连接口一起改写，那种情况下 fetch 会拿到一坨 HTML、错误被完全掩盖。
        # 用 try_files 在页面自己的 location 里做，别碰这里。

        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_pass unix:__PHP_SOCK__;
        # 若改用 TCP：fastcgi_pass 127.0.0.1:9000;
    }

    # ---------- 静态资源：长缓存 ----------
    # 构建时已带 ?v= 版本号（tools/build.py 按内容 md5 生成），内容变更版本号
    # 自动变，浏览器必定拉新文件，所以可以放心给 30 天。
    location ~* ^/assets/ {
        expires 30d;
        # 注意：`expires 30d` 自己就会下发一个 Cache-Control: max-age=2592000，
        # 加上这行会有**两个** Cache-Control 响应头。这是刻意的，不是笔误：
        # RFC 9111 允许重复的 Cache-Control 并会把指令合并，合起来等于
        # max-age=2592000 + public + immutable。immutable 才是重点 ——
        # 它让浏览器刷新时**不再回源校验**，对本站（冷启动慢）是实际收益。
        # 所以别为了"消掉重复头"删掉这行，那会把 immutable 一起删掉。
        add_header Cache-Control "public, max-age=2592000, immutable";

        # ⚠️ nginx 的 add_header 是"不继承"：本层一旦出现任何 add_header，server 级
        #    那几个安全头在这类响应上就**全部消失**。所以每个自己写了 add_header 的
        #    location 都必须把安全头重复一遍。下面 5 行与 server 级那段必须保持一致。
        #    2026-09-15 实测确认过这个坑真的会发作（当时 HTML 响应上一个安全头都没有）。
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=86400" always;
    }

    # ---------- HTML：不缓存 ----------
    # 每次回源，保证页面更新即时生效（版本戳只管 assets，不管 HTML 本身）
    location ~* \.html$ {
        add_header Cache-Control "no-cache";

        # 同上：这里也必须重复安全头，否则 HTML 反而拿不到 noindex/nosniff。
        # 而 HTML 恰恰是最需要 X-Robots-Tag 的响应体。
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=86400" always;
    }

    # ---------- 安全头（server 级）----------
    # 不希望被搜索引擎收录：robots.txt 里**故意不写** `Disallow: /`，否则爬虫读不到
    # 这个头，noindex 就失效了（两者是配合关系，不是二选一）。
    # ⚠️ 这几个头只对"没有自己的 add_header 的 location"生效；上面 assets 与
    #    .html 两段各重复了一份，改这里时记得一起改（否则会静默不同步）。
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # HSTS：让浏览器在本地就把 http 改写成 https（装好之后连明文请求都不再发出）。
    # max-age 先给 1 天（渐进上线）：它是"浏览器里没有绕过按钮"的锁，证书一旦失效，
    # 站点在 max-age 到期前会直接打不开。稳定后调大成 31536000；撤销用 max-age=0。
    # 不加 includeSubDomains / preload：本站没必要扩大影响面。
    # 这条与 deploy/.htaccess 里的值必须一致（两个部署路径不能有行为差异）。
    add_header Strict-Transport-Security "max-age=86400" always;

    # ---------- 背景音乐 ----------
    # assets/music/music.dat 由 nginx 按无扩展名表项处理，响应头是
    # Content-Type: application/octet-stream。这是**可以**接受的：
    #   1) assets/js/main.js 的探测是"反向判断"——只拒绝 html|xml|json，
    #      octet-stream 明确放行（注释见 main.js 里 music.dat 那一段）；
    #   2) <audio> 会自行嗅探解码；
    #   3) 同样的组合（nosniff + octet-stream + .dat）已在现有线上站点实测可用。
    # ⚠️ 不要为了"更规范"给 .dat 加 AddType audio/mpeg：改 types 会牵扯 MIME
    #    继承、还可能要在 location 里再重复一遍安全头，收益为零、风险不为零。
    #    真要改，先在 tools/verify_vps.py --phase site 上加一条断言再动手。

    # ---------- 阶段 E：可选的 Node WebSocket 服务反代（示例） ----------
    # 启用条件（缺一不可）：装了 Node 20、服务已部署到 /opt/<你的服务> 并起好 systemd、
    # 并且前端那边的连接地址已改为 wss://__DOMAIN__/<你的路径> 并重新打包。
    # 三者没齐之前保持注释，不要提前放开。
    # location /<你的路径> {
    #     proxy_pass http://127.0.0.1:8088;
    #     proxy_http_version 1.1;
    #     proxy_set_header Upgrade $http_upgrade;
    #     proxy_set_header Connection "upgrade";
    #     proxy_set_header Host $host;
    #     proxy_read_timeout 3600s;
    #     proxy_send_timeout 3600s;
    # }

    # ---------- HTTPS ----------
    # nginx 1.18（Ubuntu 22.04 自带版本）用 `listen ... ssl http2` 这种写法；
    # `http2 on;` 是 1.25.1+ 才有的新指令，在本机上是语法错误。
    # ⚠️ certbot 的 --nginx 插件改写 listen 行时会保留 http2 标志；
    #    但如果你手动跑 `certbot --nginx -d <域名>` 重装证书，装完请回读本文件
    #    确认 http2 没被吃掉（web 根配置以本文件为准，别让它被 certbot 降级）。
    listen 443 ssl http2;
    listen [::]:443 ssl http2;

    ssl_certificate     /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

# ---------- HTTP → HTTPS 强制跳转 ----------
# 解锁凭证/会话凭证都是 Secure Cookie，http 页面既读不到也无权改写它们
# （RFC6265bis「Leave Secure Cookies Alone」），于是"先在 https 解锁、之后用
# http 打开"会永久被弹回锁页（2026-09-12 实测复现）。
# 做法就是把站点放进 443，另起这个 80 的块只做 301，从入口消灭 http/https 混用。
# return 的替换串不含 ?，原查询串会被自动保留。
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    # 不对外暴露 nginx 版本号。`server_tokens` 的作用域是 http|server|location，
    # **不跨 server 块继承** —— 443 块里写过了这一行，这个 80 块（`return 301`
    # 与陌生 Host 的 `return 404` 响应）照样会输出 `Server: nginx/1.18.0 (Ubuntu)`，
    # 404 页正文页脚也带版本号。而 80 恰恰是扫描器与爬虫先打的门（HSTS 生效之前、
    # 新扫的 IP 段都会先试明文），所以两处都要写（第七轮 S12-01）。
    server_tokens off;

    # 只对本域名的明文请求跳 https。主机头不是本域名的（例如有人直接访问裸 IP）
    # 保持 404：否则会把用户丢到 https://<裸IP>，而证书不覆盖 IP，必然握手失败，
    # 体验比一个干净的 404 更差。这是 certbot 生成的原配置就有的行为，别删。
    if ($host != __DOMAIN__) { return 404; }

    # return 的替换串不含 ?，原查询串会被自动保留。
    return 301 https://$host$request_uri;
}
